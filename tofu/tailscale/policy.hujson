{
  "tagOwners": {
    "tag:fleet-thinkpad": ["autogroup:admin"],
    "tag:fleet-racknerd": ["autogroup:admin"],
    "tag:fleet-bastion": ["autogroup:admin"],
    "tag:fleet-dino": ["autogroup:admin"]
  },
  "acls": [],
  "ssh": [],
  "autoApprovers": {},
  "grants": [
    {
      "src": ["tag:fleet-thinkpad"],
      "dst": ["tag:fleet-racknerd", "tag:fleet-bastion", "tag:fleet-dino"],
      "ip": ["tcp:22", "icmp:*"]
    }
  ],
  "tests": [
    {
      "src": "tag:fleet-thinkpad",
      "proto": "tcp",
      "accept": ["tag:fleet-racknerd:22", "tag:fleet-bastion:22", "tag:fleet-dino:22"],
      "deny": ["tag:fleet-racknerd:80", "tag:fleet-bastion:443", "tag:fleet-dino:3389"]
    },
    {
      "src": "tag:fleet-thinkpad",
      "proto": "icmp",
      "accept": ["tag:fleet-racknerd:0", "tag:fleet-bastion:0", "tag:fleet-dino:0"]
    },
    {
      "src": "tag:fleet-thinkpad",
      "proto": "udp",
      "deny": ["tag:fleet-racknerd:22", "tag:fleet-bastion:22", "tag:fleet-dino:22"]
    },
    {
      "src": "tag:fleet-racknerd",
      "proto": "tcp",
      "deny": ["tag:fleet-thinkpad:22", "tag:fleet-bastion:22", "tag:fleet-dino:22"]
    },
    {
      "src": "tag:fleet-bastion",
      "proto": "tcp",
      "deny": ["tag:fleet-thinkpad:22", "tag:fleet-racknerd:22", "tag:fleet-dino:22"]
    },
    {
      "src": "tag:fleet-dino",
      "proto": "tcp",
      "deny": ["tag:fleet-thinkpad:22", "tag:fleet-racknerd:22", "tag:fleet-bastion:22"]
    },
    {
      "src": "tag:fleet-racknerd",
      "proto": "icmp",
      "deny": ["tag:fleet-thinkpad:0", "tag:fleet-bastion:0", "tag:fleet-dino:0"]
    },
    {
      "src": "tag:fleet-bastion",
      "proto": "icmp",
      "deny": ["tag:fleet-thinkpad:0", "tag:fleet-racknerd:0", "tag:fleet-dino:0"]
    },
    {
      "src": "tag:fleet-dino",
      "proto": "icmp",
      "deny": ["tag:fleet-thinkpad:0", "tag:fleet-racknerd:0", "tag:fleet-bastion:0"]
    }
  ]
}
